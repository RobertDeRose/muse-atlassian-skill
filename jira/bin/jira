#!/usr/bin/env python3
"""Jira Cloud CLI for the Muse jira skill.

Auth comes from the `custom.jira` connector via dynamic credential
surrogates -- never paste or store the API token here.
"""
import json
import sys
import urllib.parse
import urllib.request

sys.path.insert(0, "/opt/hatch/skills/skill-creator/bin")
from dynamic_credentials import (  # noqa: E402
    add_surrogate_to_request,
    read_json_response,
)

def _load_host():
    # Per-user config first (never committed), then env, then scaffold default.
    import os
    cfg = os.path.expanduser("~/.config/jira-skill/config.json")
    try:
        with open(cfg) as f:
            return json.load(f)["host"]
    except (OSError, KeyError, ValueError):
        pass
    host = os.environ.get("JIRA_HOST", "")
    if not host:
        sys.exit(
            "Jira host not configured. Create ~/.config/jira-skill/config.json "
            'with {"host": "YOUR-SITE.atlassian.net"} or set JIRA_HOST.'
        )
    return host


HOST = _load_host()
BASE = f"https://{HOST}/rest/api/3"
CRED = "custom.jira"


def api(method, path, body=None):
    url = BASE + path
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Accept", "application/json")
    if data:
        req.add_header("Content-Type", "application/json")
    add_surrogate_to_request(req, CRED, allowed_hosts=[HOST])
    with urllib.request.urlopen(req, timeout=30) as resp:
        if resp.status == 204:
            return {}
        return read_json_response(resp)


def cmd_me(_args):
    me = api("GET", "/myself")
    print(f"{me.get('displayName')} <{me.get('emailAddress')}> ({me.get('accountId')})")


def cmd_search(args):
    jql = args.jql
    params = {
        "jql": jql,
        "maxResults": args.max,
        "fields": "summary,status,priority,issuetype,assignee,updated",
    }
    r = api("GET", "/search/jql?" + urllib.parse.urlencode(params))
    issues = r.get("issues", [])
    print(f"{r.get('total', len(issues))} issues")
    for i in issues:
        f = i["fields"]
        status = (f.get("status") or {}).get("name", "?")
        itype = (f.get("issuetype") or {}).get("name", "?")
        assignee = (f.get("assignee") or {}).get("displayName", "unassigned")
        print(f"{i['key']} [{itype}] [{status}] {f.get('summary','')[:70]} ({assignee})")


def adf_from_text(text):
    return {
        "type": "doc",
        "version": 1,
        "content": [
            {
                "type": "paragraph",
                "content": [{"type": "text", "text": text}],
            }
        ],
    }


def cmd_get(args):
    i = api("GET", f"/issue/{args.key}?fields=summary,description,status,priority,issuetype,assignee,reporter,created,updated,comment")
    f = i["fields"]
    print(f"{i['key']}: {f.get('summary')}")
    print(f"  type: {(f.get('issuetype') or {}).get('name')}  status: {(f.get('status') or {}).get('name')}  priority: {(f.get('priority') or {}).get('name')}")
    print(f"  assignee: {(f.get('assignee') or {}).get('displayName', 'unassigned')}  reporter: {(f.get('reporter') or {}).get('displayName')}")
    print(f"  created: {f.get('created')}  updated: {f.get('updated')}")
    desc = f.get("description")
    if desc:
        txt = "".join(
            n.get("text", "")
            for b in desc.get("content", [])
            for n in b.get("content", [])
            if n.get("type") == "text"
        )
        if txt:
            print(f"  description: {txt[:500]}")
    comments = ((f.get("comment") or {}).get("comments")) or []
    if comments:
        print(f"  comments ({len(comments)}):")
        for c in comments[-5:]:
            author = (c.get("author") or {}).get("displayName", "?")
            body = "".join(
                n.get("text", "")
                for b in c.get("body", {}).get("content", [])
                for n in b.get("content", [])
                if n.get("type") == "text"
            )
            print(f"    {author}: {body[:120]}")


def cmd_create(args):
    fields = {
        "project": {"key": args.project},
        "summary": args.summary,
        "issuetype": {"name": args.issuetype},
    }
    if args.description:
        fields["description"] = adf_from_text(args.description)
    if args.priority:
        fields["priority"] = {"name": args.priority}
    if args.labels:
        fields["labels"] = args.labels.split(",")
    r = api("POST", "/issue", {"fields": fields})
    print(f"created {r['key']}")


def cmd_update(args):
    fields = {}
    if args.summary:
        fields["summary"] = args.summary
    if args.description:
        fields["description"] = adf_from_text(args.description)
    if args.priority:
        fields["priority"] = {"name": args.priority}
    if args.labels:
        fields["labels"] = [{"add": l} for l in args.labels.split(",")]
    if not fields:
        sys.exit("nothing to update")
    api("PUT", f"/issue/{args.key}", {"fields": fields})
    print(f"updated {args.key}")


def cmd_comment(args):
    r = api("POST", f"/issue/{args.key}/comment", {"body": adf_from_text(args.body)})
    print(f"comment {r['id']} added to {args.key}")


def cmd_transition(args):
    r = api("GET", f"/issue/{args.key}/transitions")
    trans = r.get("transitions", [])
    if not args.to:
        print(f"available transitions for {args.key}:")
        for t in trans:
            print(f"  {t['id']}: {t['name']}")
        return
    match = [t for t in trans if t["name"].lower() == args.to.lower()]
    if not match:
        sys.exit(f"no transition named '{args.to}'")
    api("POST", f"/issue/{args.key}/transitions", {"transition": {"id": match[0]["id"]}})
    print(f"{args.key} -> {match[0]['name']}")


def main():
    import argparse
    p = argparse.ArgumentParser(prog="jira")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("me", help="verify auth / show current user")

    s = sub.add_parser("search", help="search issues with JQL")
    s.add_argument("--jql", required=True)
    s.add_argument("--max", type=int, default=25)

    g = sub.add_parser("get", help="show issue details")
    g.add_argument("key")

    c = sub.add_parser("create", help="create an issue")
    c.add_argument("--project", required=True)
    c.add_argument("--summary", required=True)
    c.add_argument("--description", default="")
    c.add_argument("--issuetype", default="Task")
    c.add_argument("--priority", default="")
    c.add_argument("--labels", default="")

    u = sub.add_parser("update", help="update issue fields")
    u.add_argument("key")
    u.add_argument("--summary", default="")
    u.add_argument("--description", default="")
    u.add_argument("--priority", default="")
    u.add_argument("--labels", default="")

    cm = sub.add_parser("comment", help="add a comment")
    cm.add_argument("key")
    cm.add_argument("--body", required=True)

    t = sub.add_parser("transition", help="list or apply transitions")
    t.add_argument("key")
    t.add_argument("--to", default="")

    args = p.parse_args()
    try:
        {
            "me": cmd_me,
            "search": cmd_search,
            "get": cmd_get,
            "create": cmd_create,
            "update": cmd_update,
            "comment": cmd_comment,
            "transition": cmd_transition,
        }[args.cmd](args)
    except urllib.error.HTTPError as e:
        body = e.read().decode()[:500]
        sys.exit(f"HTTP {e.code}: {body}")


if __name__ == "__main__":
    main()
